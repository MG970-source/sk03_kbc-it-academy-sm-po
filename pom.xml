<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

  <!--
    Build and test definition for the Java side of the academy demo.

    The source layout is deliberately left where it was (src/api, src/monolith, …)
    so every earlier lesson's instructions still point at the right files. Tests
    live in tests/java, next to the browser tests in tests/e2e, so that "where are
    the tests" has one answer.

      mvn test        unit tests only            (fast, runs on every push)
      mvn verify      unit + integration + gate  (what the pipeline runs)
      mvn verify -Pcoverage-theatre              (see tests/README.md)
  -->

  <modelVersion>4.0.0</modelVersion>
  <groupId>bg.ubb.itacademy</groupId>
  <artifactId>banking-demo</artifactId>
  <version>1.0.0</version>
  <packaging>jar</packaging>
  <name>KBC IT Academy banking demo</name>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <junit.version>5.11.4</junit.version>
    <surefire.version>3.5.2</surefire.version>
    <jacoco.version>0.8.12</jacoco.version>

    <!-- The quality gate. The build fails below this line, on any machine,
         with no third-party service involved. It is set below where the suite
         actually sits, so that raising it is a deliberate decision taken when
         the tests improve — and never a red pipeline that somebody edits this
         number to silence. -->
    <coverage.minimum.line>0.35</coverage.minimum.line>

    <!-- Tests excluded from the normal run. See the coverage-theatre profile. -->
    <theatre.excluded>**/CoverageTheatre*.java</theatre.excluded>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <sourceDirectory>src</sourceDirectory>
    <testSourceDirectory>tests/java</testSourceDirectory>

    <plugins>
      <!-- Unit tests: *Test.java. No network, no server, no files. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>${surefire.version}</version>
        <configuration>
          <argLine>${surefireArgLine}</argLine>
          <excludes>
            <exclude>${theatre.excluded}</exclude>
          </excludes>
        </configuration>
      </plugin>

      <!-- Integration tests: *IT.java. These start the real API over real HTTP. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <version>${surefire.version}</version>
        <configuration>
          <argLine>${failsafeArgLine}</argLine>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <!-- Coverage: measured across both test tiers, then checked. -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>${jacoco.version}</version>
        <configuration>
          <!-- The two database demos are printed illustrations from Module 1
               Lesson 5, not product code, and testing their console output
               would measure nothing. Worth saying out loud in the lesson:
               deciding what the denominator contains is the quietest way a
               coverage number gets improved without a single test being
               written. Anything excluded here should be excluded for a reason
               someone is willing to defend. -->
          <excludes>
            <exclude>database/**</exclude>
          </excludes>
        </configuration>
        <executions>
          <execution>
            <id>agent-for-unit-tests</id>
            <goals><goal>prepare-agent</goal></goals>
            <configuration>
              <destFile>${project.build.directory}/jacoco.exec</destFile>
              <propertyName>surefireArgLine</propertyName>
            </configuration>
          </execution>
          <execution>
            <id>agent-for-integration-tests</id>
            <phase>pre-integration-test</phase>
            <goals><goal>prepare-agent-integration</goal></goals>
            <configuration>
              <destFile>${project.build.directory}/jacoco.exec</destFile>
              <append>true</append>
              <propertyName>failsafeArgLine</propertyName>
            </configuration>
          </execution>
          <execution>
            <id>report</id>
            <phase>post-integration-test</phase>
            <goals><goal>report</goal></goals>
            <configuration>
              <dataFile>${project.build.directory}/jacoco.exec</dataFile>
              <outputDirectory>${project.build.directory}/site/jacoco</outputDirectory>
            </configuration>
          </execution>
          <execution>
            <id>gate</id>
            <phase>verify</phase>
            <goals><goal>check</goal></goals>
            <configuration>
              <dataFile>${project.build.directory}/jacoco.exec</dataFile>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>${coverage.minimum.line}</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!--
      Classroom demonstration, Module 3 Lesson 3.
      Runs the assertion-free test in tests/java/theatre as well. Nothing is
      tested that was not tested before; the coverage number moves anyway.
    -->
    <profile>
      <id>coverage-theatre</id>
      <properties>
        <theatre.excluded>nothing-is-excluded</theatre.excluded>
      </properties>
    </profile>
  </profiles>
</project>
